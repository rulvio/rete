;; The clara side of the comparison bench. See ../README.md.
;;
;; This names which clara-rules the bench measures. A released version off Clojars is the
;; default. Swap it for `{:local/root "/path/to/clara-rules"}` to measure a checkout on
;; disk. `../report.exs` reads whichever form is here and records it next to the numbers.
{:paths ["src"]
 :deps {com.github.gateless/clara-rules {:mvn/version "1.6.8"}}

 :aliases
 ;; The heap is pinned so that heap growth does not land in a timing, and pre-touched so
 ;; that faulting its pages in does not either. Without `AlwaysPreTouch` the first JVM
 ;; started after the rete bench read about 1.6x slower than the second, on every scenario
 ;; at once, roughly one run in three. The `calibrate` row exists to catch that if it
 ;; returns.
 {:bench {:jvm-opts ["-Xms2g" "-Xmx2g" "-XX:+AlwaysPreTouch"]
          :main-opts ["-m" "bench.clara"]}}}
